import tkinter as tk
from tkinter import ttk
import cv2
import mediapipe as mp
from fer import FER
import threading
import time
from datetime import datetime
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
from collections import defaultdict

# -------------------------
# Emotion Recognition Setup
# -------------------------
detector = FER(mtcnn=True)
cap = cv2.VideoCapture(0)

emotion_history = defaultdict(list)  # speichert Zeitstempel + Werte je Emotion
running = True

def capture_emotions():
    """Thread-Funktion zur Erkennung und Speicherung von Emotionen."""
    global running
    while running:
        ret, frame = cap.read()
        if not ret:
            continue

        # Emotionen erkennen
        emotions = detector.detect_emotions(frame)
        if emotions:
            scores = emotions[0]["emotions"]
            current_time = datetime.now().strftime("%H:%M:%S")

            for emo, val in scores.items():
                emotion_history[emo].append((current_time, val))

        time.sleep(2)  # alle 2 Sekunden messen

threading.Thread(target=capture_emotions, daemon=True).start()

# -------------------------
# GUI Setup
# -------------------------
root = tk.Tk()
root.title("Emotionserkennung Diplomarbeit")
root.geometry("900x600")

notebook = ttk.Notebook(root)
notebook.pack(fill="both", expand=True)

# Tab 1: Live Emotion Recognition
frame_live = ttk.Frame(notebook)
notebook.add(frame_live, text="Live Emotionen")

lbl_info = tk.Label(frame_live, text="Hier läuft die Emotionserkennung...", font=("Arial", 14))
lbl_info.pack(pady=20)

# Tab 2: Graph
frame_graph = ttk.Frame(notebook)
notebook.add(frame_graph, text="Emotionsverlauf")

fig, ax = plt.subplots(figsize=(7,4))
canvas = FigureCanvasTkAgg(fig, master=frame_graph)
canvas.get_tk_widget().pack(fill="both", expand=True)

def update_graph():
    """Aktualisiert das Liniendiagramm mit den Emotionen."""
    ax.clear()
    if not emotion_history:
        ax.set_title("Noch keine Daten...")
        canvas.draw()
        root.after(2000, update_graph)
        return

    for emo, values in emotion_history.items():
        if values:
            times = [v[0] for v in values]
            vals = [v[1] for v in values]
            ax.plot(times, vals, label=emo)  # Liniendiagramm

    ax.set_title("Emotionsverlauf")
    ax.set_xlabel("Zeit")
    ax.set_ylabel("Wahrscheinlichkeit")
    ax.legend(loc="upper right")
    plt.xticks(rotation=45)
    canvas.draw()

    root.after(2000, update_graph)  # alle 2 Sekunden aktualisieren

update_graph()

def on_closing():
    global running
    running = False
    cap.release()
    root.destroy()

root.protocol("WM_DELETE_WINDOW", on_closing)
root.mainloop()
